


LLM_PROVIDER=gemini
GEMINI_API_KEY=your_api_key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent

# NVIDIA API Configuration for Embeddings
NVIDIA_EMBEDDINGS_API_KEY=your_nvidia_api_key
NVIDIA_LLM_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL_EN=nvidia/llama-nemotron-embed-vl-1b-v2
NVIDIA_EMBED_MODEL_MULTI=nvidia/nv-embedqa-mistral-7b-v2
NVIDIA_EMBEDDING_DIMENSION=1024

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# File Storage
UPLOAD_DIR=./uploads

# MongoDB Configuration (for chat history)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=knowledgebase
MONGO_COLLECTION_CHAT_HISTORY=chat_history
MONGO_COLLECTION_CONVERSATIONS=conversations

# Chroma Cloud Configuration
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=knowledgebase

LOG_LEVEL=INFO
