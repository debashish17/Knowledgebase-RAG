# ============================================
# Application Configuration
# ============================================
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8080

# ============================================
# ChromaDB Configuration (Embedded Mode)
# ============================================
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ============================================
# NVIDIA NIM API Configuration (Required)
# ============================================
# NVIDIA Embeddings API Key - Get from https://build.nvidia.com/
NVIDIA_EMBEDDINGS_API_KEY=your_nvidia_embeddings_api_key_here

# NVIDIA LLM API Key - Get from https://build.nvidia.com/
NVIDIA_LLM_API_KEY=your_nvidia_llm_api_key_here

# NVIDIA API Configuration
NVIDIA_LLM_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL_EN=nvidia/nv-embedqa-e5-v5
NVIDIA_LLM_MODEL=mistralai/mistral-7b-instruct-v0.3

# ============================================
# Document Processing
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ============================================
# RAG Configuration
# ============================================
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7
MAX_TOKENS=1024
TEMPERATURE=0.7

# ============================================
# MongoDB Configuration
# ============================================
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=knowledgebase
MONGO_COLLECTION_CONVERSATIONS=conversations

