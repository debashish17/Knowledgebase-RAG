
ENVIRONMENT=development

CHROMA_PERSIST_DIR=./chroma_db

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_PROVIDER=nvidia

# NVIDIA Embeddings API Key
NVIDIA_EMBEDDINGS_API_KEY=your_nvidia_embeddings_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_EMBEDDING_DIMENSION=1024

# NVIDIA LLM API Key for Answer Generation
NVIDIA_LLM_API_KEY=your_nvidia_llm_api_key_here
NVIDIA_LLM_MODEL=nv-mistralai/mistral-nemo-12b-instruct

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# File Storage  
UPLOAD_DIR=./uploads
USE_S3=false
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# MongoDB Configuration (for chat history)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=knowledgebase
MONGO_COLLECTION_CHAT_HISTORY=chat_history
MONGO_COLLECTION_CONVERSATIONS=conversations


LOG_LEVEL=INFO
