# ============================================
# Environment Configuration
# ============================================
ENVIRONMENT=development

# ============================================
# Vector Database - ChromaDB
# ============================================
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ============================================
# Embeddings Configuration
# ============================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_PROVIDER=nvidia

# NVIDIA Embeddings API Key
NVIDIA_EMBEDDINGS_API_KEY=your_nvidia_embeddings_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_EMBEDDING_DIMENSION=1024

# ============================================
# LLM Configuration - NVIDIA NIM
# ============================================
# NVIDIA LLM API Key for Answer Generation
NVIDIA_LLM_API_KEY=your_nvidia_llm_api_key_here
NVIDIA_LLM_MODEL=nv-mistralai/mistral-nemo-12b-instruct

# ============================================
# Document Processing
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ============================================
# MongoDB Configuration (Optional)
# ============================================
USE_MONGODB=false
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=knowledgebase_rag
MONGO_COLLECTION_CHAT_HISTORY=chat_history
MONGO_COLLECTION_CONVERSATIONS=conversations

# ============================================
# API Configuration
# ============================================
CORS_ORIGINS=*
LOG_LEVEL=INFO

